.filter-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16rpx; }
.is-selected { border-color: #059669; background: #ECFDF5; }
.recommendation { border-left: 8rpx solid #059669; }
.recommendation-text { color: #0F172A; font-weight: 600; line-height: 1.7; }
.result-section { margin-top: 24rpx; }
.result-title { display: flex; justify-content: space-between; margin-bottom: 14rpx; color: #0F172A; font-weight: 700; }
