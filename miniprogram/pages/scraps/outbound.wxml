<view class="container">
  <view class="simple-header">
    <view class="simple-title">余料出库</view>
    <view class="simple-subtitle">筛选可用余料，再填写本次出库信息</view>
  </view>

  <state-view wx:if="{{loading}}" state="loading" title="正在读取可出库余料" />
  <state-view wx:elif="{{error}}" state="error" title="可出库余料加载失败" description="{{error}}" bind:retry="load" />
  <block wx:else>
  <view class="form-section">
    <view class="form-field"><view class="form-label">材质</view><input class="input" placeholder="例如 45#" value="{{filters.material}}" data-field="material" bindinput="onFilter" /></view>
    <view class="form-field"><view class="form-label">厚度</view><input class="input" type="digit" placeholder="例如 3.0" value="{{filters.thickness}}" data-field="thickness" bindinput="onFilter" /></view>
    <view class="form-field"><view class="form-label">所需直径</view><input class="input" type="digit" placeholder="请输入最小直径" value="{{filters.required_diameter}}" data-field="required_diameter" bindinput="onFilter" /></view>
    <view class="form-field"><view class="form-label">库位</view><input class="input" placeholder="例如 B-02" value="{{filters.location}}" data-field="location" bindinput="onFilter" /></view>
    <button class="btn secondary" bindtap="load">查询可出库余料</button>
  </view>

  <view class="form-section">
    <view class="form-field"><view class="form-label">余料规格</view><picker range="{{items}}" range-key="label" bindchange="onPick"><view class="picker">{{selectedLabel}}</view></picker></view>
    <view class="form-field"><view class="form-label">出库数量</view><input class="input" type="number" placeholder="请输入数量" value="{{form.quantity}}" data-field="quantity" bindinput="onInput" /></view>
    <view class="form-field"><view class="form-label">操作人</view><input class="input" placeholder="请输入姓名" value="{{form.operator_name}}" data-field="operator_name" bindinput="onInput" /></view>
    <view class="form-field"><view class="form-label">备注</view><input class="input" placeholder="填写去向或用途" value="{{form.remark}}" data-field="remark" bindinput="onInput" /></view>
    <button class="primary-action" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">确认出库</button>
  </view>

  <view class="data-list">
    <view wx:if="{{!items.length}}" class="empty">请先查询匹配余料</view>
    <view wx:for="{{items}}" wx:key="group_key" class="data-item">
      <view class="row">
        <view class="name">{{item.material}}｜{{item.usable_size}}</view>
        <view class="badge numeric">{{item.quantity}}</view>
      </view>
      <view class="meta">厚度 {{item.thickness}}｜库位 {{item.location}}</view>
    </view>
  </view>
  </block>

  <confirm-sheet
    open="{{confirmOpen}}"
    title="核对余料出库"
    lines="{{confirmLines}}"
    submitting="{{submitting}}"
    bindcancel="cancelConfirm"
    bindconfirm="confirmSubmit"
  />
</view>
