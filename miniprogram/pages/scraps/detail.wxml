<view class="container">
  <view class="simple-header">
    <view class="simple-title">余料批次明细</view>
    <view class="simple-subtitle">{{group.material || '-'}}｜厚度 {{group.thickness || '-'}}｜{{group.usable_size || '-'}}</view>
  </view>

  <state-view wx:if="{{loading}}" state="loading" title="正在读取余料批次" />
  <state-view wx:elif="{{error}}" state="error" title="余料批次加载失败" description="{{error}}" bind:retry="load" />
  <block wx:else>
    <view class="detail-summary">
      <view>
        <view class="detail-summary__label">当前总数量</view>
        <view class="detail-summary__meta">库位 {{group.location || '-'}}</view>
      </view>
      <view class="detail-summary__value numeric">{{totalQuantity}}</view>
    </view>

    <view class="section-title detail-section-title">批次来源</view>
    <state-view wx:if="{{!batches.length}}" state="empty" title="暂无余料批次" />
    <view wx:else class="data-list">
      <view wx:for="{{batches}}" wx:key="id" class="data-item">
        <view class="row">
          <view class="name">{{item.source_product_text}}</view>
          <view class="badge numeric">{{item.quantity}}</view>
        </view>
        <view class="meta">来源图纸 {{item.source_drawing_text}}</view>
        <view class="meta">库位 {{item.location_text}}｜{{item.status_text}}</view>
        <view class="meta">可用尺寸 {{item.usable_size_text}}｜理论尺寸 {{item.theoretical_size_text}}｜实际尺寸 {{item.actual_size_text}}</view>
        <view class="meta">登记人 {{item.operator_text}}｜{{item.registered_at_text}}</view>
      </view>
    </view>

    <view class="section-title detail-section-title">流水</view>
    <state-view wx:if="{{!transactions.length}}" state="empty" title="暂无相关流水" />
    <view wx:else class="ledger-list">
      <view wx:for="{{transactions}}" wx:key="id" class="ledger-item">
        <view class="row">
          <view class="name">{{item.transaction_type_text}}</view>
          <view class="badge numeric">{{item.quantity}}</view>
        </view>
        <view class="meta">操作前 {{item.before_quantity}}｜操作后 {{item.after_quantity}}｜库位 {{item.location_text}}</view>
        <view class="meta">客户/去向 {{item.customer_text}}｜操作人 {{item.operator_text}}</view>
        <view class="meta">{{item.remark_text}}｜{{item.created_at_text}}</view>
      </view>
    </view>
  </block>
</view>
