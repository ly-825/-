<view class="container">
  <view class="simple-header">
    <view class="simple-title">待入库余料</view>
    <view class="simple-subtitle">核对实际数量、直径与库位</view>
  </view>

  <state-view wx:if="{{loading}}" state="loading" title="正在读取待确认余料" />
  <state-view wx:elif="{{error}}" state="error" title="待确认余料加载失败" description="{{error}}" bind:retry="load" />
  <view wx:else class="data-list">
    <view wx:if="{{!items.length}}" class="empty">暂无待入库余料</view>
    <view wx:for="{{items}}" wx:key="id" class="data-item">
      <view class="row">
        <view class="name">{{item.source_product_code_text}}</view>
        <view class="badge numeric">{{item.quantity}}</view>
      </view>
      <view class="meta">{{item.material}}｜厚度 {{item.thickness}}｜理论直径 {{item.diameter_text}}</view>
      <view class="pending-fields">
        <view class="form-field"><view class="form-label">实际数量</view><input class="input" type="number" placeholder="请输入数量" value="{{item.actual_quantity}}" data-index="{{index}}" data-field="actual_quantity" bindinput="onInput" /></view>
        <view class="form-field"><view class="form-label">实际直径</view><input class="input" type="digit" placeholder="留空沿用理论值" value="{{item.actual_diameter}}" data-index="{{index}}" data-field="actual_diameter" bindinput="onInput" /></view>
        <view class="form-field"><view class="form-label">库位 *</view><input class="input" placeholder="例如 B-02" value="{{item.confirm_location}}" data-index="{{index}}" data-field="confirm_location" bindinput="onInput" /></view>
        <view class="form-field"><view class="form-label">确认人</view><input class="input" placeholder="请输入姓名" value="{{item.operator_name}}" data-index="{{index}}" data-field="operator_name" bindinput="onInput" /></view>
      </view>
      <button class="btn secondary" bindtap="confirm" data-index="{{index}}" loading="{{item.confirming}}" disabled="{{item.confirming || submitting}}">确认入库</button>
    </view>
  </view>

  <confirm-sheet
    open="{{confirmOpen}}"
    title="核对余料入库"
    lines="{{confirmLines}}"
    submitting="{{submitting}}"
    bindcancel="cancelConfirm"
    bindconfirm="confirmSubmit"
  />
</view>
