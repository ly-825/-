<view class="container">
  <view class="simple-header">
    <view class="simple-title">余料</view>
    <view class="simple-subtitle">确认待入库余料，查询库存并执行出库</view>
  </view>
  <state-view wx:if="{{loading}}" state="loading" title="正在读取余料概览" />
  <state-view wx:elif="{{error}}" state="error" title="余料概览加载失败" description="{{error}}" bind:retry="load" />
  <view wx:else class="group-list">
    <view class="group-row" bindtap="go" data-url="/pages/scraps/pending"><view class="group-row__body"><view class="group-row__title">待入库余料</view><view class="group-row__meta group-row__status">{{pendingCount}} 条待确认</view></view><image class="group-row__chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
    <view class="group-row" bindtap="go" data-url="/pages/scraps/list"><view class="group-row__body"><view class="group-row__title">余料库存</view><view class="group-row__meta">当前可用 {{availableQuantity}}</view></view><image class="group-row__chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
    <view class="group-row" bindtap="go" data-url="/pages/scraps/outbound"><view class="group-row__body"><view class="group-row__title">余料出库</view><view class="group-row__meta">按规格和库位汇总出库</view></view><image class="group-row__chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
    <view class="group-row" bindtap="go" data-url="/pages/scraps/transactions"><view class="group-row__body"><view class="group-row__title">余料流水</view><view class="group-row__meta">查看确认、出库与撤销记录</view></view><image class="group-row__chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
  </view>
</view>
