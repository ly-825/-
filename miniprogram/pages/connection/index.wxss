.connection-page {
  padding-top: 72rpx;
}

.page-heading {
  margin-bottom: 48rpx;
}

.help-card {
  display: grid;
  gap: 16rpx;
  color: #475569;
  font-size: 26rpx;
}

.text-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 8rpx;
  border: 0;
  background: transparent;
  color: #475569;
  font-size: 26rpx;
  line-height: 88rpx;
  white-space: nowrap;
}

.text-action::after {
  border: 0;
}
