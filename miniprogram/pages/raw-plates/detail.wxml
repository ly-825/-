<view class="container"><view class="simple-header"><view class="simple-title">钢板批次</view><view class="simple-subtitle">{{group.spec_name}}｜{{group.material}}</view></view><state-view wx:if="{{loading}}" state="loading" title="正在读取批次"/><state-view wx:elif="{{error}}" state="error" title="批次加载失败" description="{{error}}" bind:retry="load"/><state-view wx:elif="{{!items.length}}" state="empty" title="暂无可用批次"/><view wx:else class="data-list"><view wx:for="{{items}}" wx:key="id" class="data-item"><view class="name">{{item.material_code||'未编号'}}｜{{item.quantity}} 块</view><view class="meta">{{item.raw_plate_model}}｜库位 {{item.location||'-'}}</view><button class="btn secondary" data-index="{{index}}" bindtap="edit">修改批次</button></view></view><view wx:if="{{form}}" class="form-section batch-form"><view class="form-label">批次编号</view><input class="input" value="{{form.material_code}}" data-field="material_code" bindinput="onInput"/><view class="form-label">板料型号</view><input class="input" value="{{form.raw_plate_model}}" data-field="raw_plate_model" bindinput="onInput"/><view class="form-label">库位</view><input class="input" value="{{form.location}}" data-field="location" bindinput="onInput"/><view class="form-label">操作人</view><input class="input" data-field="operator_name" bindinput="onInput"/><view class="form-label">修改原因</view><input class="input" data-field="remark" bindinput="onInput"/><button class="primary-action" bindtap="submit">保存批次修改</button></view><confirm-sheet open="{{confirmOpen}}" title="核对批次修改" lines="{{confirmLines}}" submitting="{{submitting}}" bindcancel="cancelConfirm" bindconfirm="confirmSubmit"/></view>
