<view class="container"><view class="simple-header"><view class="simple-title">{{id ? '修改' : '新增'}}钢板规格</view></view><state-view wx:if="{{loading}}" state="loading" title="正在读取规格"/><state-view wx:elif="{{error}}" state="error" title="保存失败" description="{{error}}"/><view class="form-section"><view class="form-label">材质</view><input class="input" value="{{form.material}}" data-field="material" bindinput="onInput"/><view class="form-label">长度 mm</view><input class="input" value="{{form.length}}" data-field="length" bindinput="onInput"/><view class="form-label">宽度 mm</view><input class="input" value="{{form.width}}" data-field="width" bindinput="onInput"/><view class="form-label">厚度 mm</view><input class="input" value="{{form.thickness}}" data-field="thickness" bindinput="onInput"/><view class="form-label">密度 g/cm³</view><input class="input" value="{{form.density}}" data-field="density" bindinput="onInput"/><view class="form-label">备注</view><input class="input" value="{{form.remark}}" data-field="remark" bindinput="onInput"/><button class="primary-action" bindtap="submit">保存规格</button></view><confirm-sheet open="{{confirmOpen}}" title="核对钢板规格" lines="{{confirmLines}}" submitting="{{submitting}}" bindcancel="cancelConfirm" bindconfirm="confirmSubmit"/></view>
