<view class="container"><view class="simple-header"><view class="simple-title">钢板出库</view><view class="simple-subtitle">先选规格，再按最早批次 FIFO 扣减</view></view><state-view wx:if="{{loading}}" state="loading" title="正在读取可用钢板"/><state-view wx:elif="{{error}}" state="error" title="操作失败" description="{{error}}" bind:retry="load"/><state-view wx:elif="{{!items.length}}" state="empty" title="暂无可出库钢板"/><view wx:else class="data-list"><view wx:for="{{items}}" wx:key="spec_name" class="data-item {{selected.spec_name===item.spec_name?'selected':''}}" data-index="{{index}}" bindtap="select"><view class="name">{{item.spec_name}}｜{{item.material}}</view><view class="meta">可出库 {{item.quantity}} 块｜{{item.locations.join(' / ')||'-'}}</view></view></view><view class="form-section"><view class="form-label">出库数量</view><input class="input" type="number" data-field="quantity" bindinput="input"/><view class="form-label">指定库位（可选）</view><input class="input" data-field="location" bindinput="input"/><view class="form-label">客户/去向</view><input class="input" data-field="customer_name" bindinput="input"/><view class="form-label">操作人</view><input class="input" data-field="operator_name" bindinput="input"/><view class="form-label">备注</view><input class="input" data-field="remark" bindinput="input"/><button class="primary-action" bindtap="submit">确认出库</button></view><confirm-sheet open="{{confirmOpen}}" title="核对钢板出库" lines="{{confirmLines}}" submitting="{{submitting}}" bindcancel="cancelConfirm" bindconfirm="confirmSubmit"/></view>
