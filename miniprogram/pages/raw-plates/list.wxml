<view class="container"><view class="simple-header"><view class="simple-title">钢板库存</view></view><view class="filter"><input class="input" placeholder="批次、型号、材质或库位" value="{{q}}" bindinput="onInput"/><button class="btn secondary" bindtap="load">查询</button></view><state-view wx:if="{{loading}}" state="loading" title="正在读取库存"/><state-view wx:elif="{{error}}" state="error" title="库存加载失败" description="{{error}}" bind:retry="load"/><state-view wx:elif="{{!items.length}}" state="empty" title="暂无可用钢板"/><view wx:else class="data-list"><view wx:for="{{items}}" wx:key="spec_name" class="data-item" data-index="{{index}}" bindtap="detail"><view class="name">{{item.spec_name}}｜{{item.material}}</view><view class="meta">库存 {{item.quantity}} 块｜{{item.batch_count}} 批｜库位 {{item.locations.join(' / ') || '-'}}</view></view></view></view>
