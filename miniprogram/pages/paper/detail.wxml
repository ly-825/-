<view class="container"><view class="simple-header"><view class="simple-title">纸材批次</view><view class="simple-subtitle">{{group.model}}｜{{group.material_name}}</view></view><state-view wx:if="{{loading}}" state="loading" title="正在读取批次"/><state-view wx:elif="{{error}}" state="error" title="批次加载失败" description="{{error}}" bind:retry="load"/><state-view wx:elif="{{!items.length}}" state="empty" title="暂无可用批次"/><view wx:else class="data-list"><view wx:for="{{items}}" wx:key="id" class="data-item"><view class="name">{{item.batch_code}}｜{{item.quantity}} {{item.unit}}</view><view class="meta">单价 ¥{{item.unit_price}}｜库位 {{item.location||'-'}}｜{{item.created_at}}</view></view></view></view>
