<view class="container"><view class="simple-header"><view class="simple-title">纸材规格</view></view><view class="toolbar"><input class="input" placeholder="型号或材质" bindinput="input"/><button class="btn secondary" bindtap="load">查询</button></view><button class="primary-action" bindtap="create">新增规格</button><state-view wx:if="{{loading}}" state="loading" title="正在读取规格"/><state-view wx:elif="{{error}}" state="error" title="规格加载失败" description="{{error}}" bind:retry="load"/><state-view wx:elif="{{!items.length}}" state="empty" title="暂无纸材规格"/><view wx:else class="data-list"><view wx:for="{{items}}" wx:key="id" class="data-item"><view class="name">{{item.paper_type==='roll'?'纸圈':'纸张'}}｜{{item.model}}</view><view class="meta">{{item.material_name}}｜厚度 {{item.thickness}}｜{{item.is_active?'启用':'停用'}}</view><view class="row"><button class="btn secondary" data-index="{{index}}" bindtap="edit">修改</button><button class="btn secondary" data-index="{{index}}" bindtap="toggle">{{item.is_active?'停用':'启用'}}</button></view></view></view></view>
