<view class="container"><view class="simple-header"><view class="simple-title">纸材入库</view></view><state-view wx:if="{{loading}}" state="loading" title="正在读取规格"/><state-view wx:elif="{{error}}" state="error" title="操作失败" description="{{error}}" bind:retry="load"/><view wx:else class="form-section"><view class="form-label">纸材规格</view><picker range="{{specs}}" range-key="model" bindchange="select"><view class="picker">{{selected ? selected.model : '请选择启用规格'}}</view></picker><view class="form-label">批次编号</view><input class="input" data-field="batch_code" bindinput="input"/><view class="form-label">入库数量</view><input class="input" type="number" data-field="quantity" bindinput="input"/><view class="form-label">入库单价</view><input class="input" type="digit" data-field="unit_price" bindinput="input"/><view class="form-label">库位</view><input class="input" data-field="location" bindinput="input"/><view class="form-label">操作人</view><input class="input" data-field="operator_name" bindinput="input"/><view class="form-label">备注</view><input class="input" data-field="remark" bindinput="input"/><button class="primary-action" bindtap="submit">确认入库</button></view><confirm-sheet open="{{confirmOpen}}" title="核对纸材入库" lines="{{confirmLines}}" submitting="{{submitting}}" bindcancel="cancelConfirm" bindconfirm="confirmSubmit"/></view>
