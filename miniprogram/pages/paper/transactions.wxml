<view class="container"><view class="simple-header"><view class="simple-title">纸材流水</view></view><state-view wx:if="{{loading}}" state="loading" title="正在读取纸材流水"/><state-view wx:elif="{{error}}" state="error" title="流水加载失败" description="{{error}}" bind:retry="load"/><state-view wx:elif="{{!items.length}}" state="empty" title="暂无纸材流水"/><view wx:else class="ledger-list"><view wx:for="{{items}}" wx:key="id" class="ledger-item"><view class="name">{{item.transaction_type==='in'?'入库':'出库'}}｜{{item.batch.batch_code}}｜{{item.quantity}} {{item.batch.unit}}</view><view class="meta">库存 {{item.before_quantity}} → {{item.after_quantity}}｜{{item.operator_name||'-'}}｜{{item.remark||'-'}}</view><button wx:if="{{!item.reversed_transaction_id}}" class="danger-action" data-index="{{index}}" bindtap="reverse">撤销流水</button></view></view><confirm-sheet open="{{confirmOpen}}" title="确认撤销纸材流水" lines="{{confirmLines}}" submitting="{{submitting}}" bindcancel="cancelConfirm" bindconfirm="confirmSubmit"/></view>
