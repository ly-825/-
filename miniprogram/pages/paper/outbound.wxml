<view class="container"><view class="simple-header"><view class="simple-title">纸材出库</view><view class="simple-subtitle">按规格和可选库位 FIFO 扣减</view></view><state-view wx:if="{{loading}}" state="loading" title="正在读取可用纸材"/><state-view wx:elif="{{error}}" state="error" title="操作失败" description="{{error}}" bind:retry="load"/><state-view wx:elif="{{!items.length}}" state="empty" title="暂无可出库纸材"/><view wx:else class="data-list"><view wx:for="{{items}}" wx:key="specification_id" class="data-item {{selected.specification_id===item.specification_id?'selected':''}}" data-index="{{index}}" bindtap="select"><view class="name">{{item.type_label}}｜{{item.model}}｜{{item.material_name}}</view><view class="meta">可出库 {{item.quantity}} {{item.unit}}｜{{item.size}}</view></view></view><view class="form-section"><view class="form-label">出库数量</view><input class="input" type="number" data-field="quantity" bindinput="input"/><view class="form-label">指定库位（可选）</view><input class="input" data-field="location" bindinput="input"/><view class="form-label">客户/去向</view><input class="input" data-field="customer_name" bindinput="input"/><view class="form-label">操作人</view><input class="input" data-field="operator_name" bindinput="input"/><view class="form-label">备注</view><input class="input" data-field="remark" bindinput="input"/><button class="primary-action" bindtap="submit">确认出库</button></view><confirm-sheet open="{{confirmOpen}}" title="核对纸材出库" lines="{{confirmLines}}" submitting="{{submitting}}" bindcancel="cancelConfirm" bindconfirm="confirmSubmit"/></view>
