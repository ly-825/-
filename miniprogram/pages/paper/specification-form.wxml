<view class="container"><view class="simple-header"><view class="simple-title">纸材规格</view></view><state-view wx:if="{{loading}}" state="loading" title="正在读取规格"/><state-view wx:elif="{{error}}" state="error" title="保存失败" description="{{error}}"/><view class="type-switch"><button class="btn secondary" data-type="roll" bindtap="type">纸圈</button><button class="btn secondary" data-type="sheet" bindtap="type">纸张</button></view><view class="form-section"><view class="form-label">纸材名称/材质</view><input class="input" value="{{form.material_name}}" data-field="material_name" bindinput="input"/><view class="form-label">厚度 mm</view><input class="input" value="{{form.thickness}}" data-field="thickness" bindinput="input"/><block wx:if="{{form.paper_type==='roll'}}"><view class="form-label">纸圈型号</view><input class="input" value="{{form.model}}" data-field="model" bindinput="input"/><view class="form-label">内径 mm</view><input class="input" value="{{form.inner_diameter}}" data-field="inner_diameter" bindinput="input"/><view class="form-label">外径 mm</view><input class="input" value="{{form.outer_diameter}}" data-field="outer_diameter" bindinput="input"/></block><block wx:else><view class="form-label">长度 mm</view><input class="input" value="{{form.length}}" data-field="length" bindinput="input"/><view class="form-label">宽度 mm</view><input class="input" value="{{form.width}}" data-field="width" bindinput="input"/></block><view class="form-label">备注</view><input class="input" value="{{form.remark}}" data-field="remark" bindinput="input"/><button class="primary-action" bindtap="submit">保存规格</button></view><confirm-sheet open="{{confirmOpen}}" title="核对纸材规格" lines="{{confirmLines}}" submitting="{{submitting}}" bindcancel="cancelConfirm" bindconfirm="confirmSubmit"/></view>
