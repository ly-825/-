<view class="container"><view class="simple-header"><view class="simple-title">纸材库存</view></view><state-view wx:if="{{loading}}" state="loading" title="正在读取纸材库存"/><state-view wx:elif="{{error}}" state="error" title="库存加载失败" description="{{error}}" bind:retry="load"/><state-view wx:elif="{{!items.length}}" state="empty" title="暂无纸材库存"/><view wx:else class="data-list"><view wx:for="{{items}}" wx:key="specification_id" class="data-item" data-index="{{index}}" bindtap="detail"><view class="name">{{item.type_label}}｜{{item.model}}｜{{item.material_name}}</view><view class="meta">{{item.size}}｜库存 {{item.quantity}} {{item.unit}}｜{{item.batch_count}} 批｜单价 {{item.price_min}} 至 {{item.price_max}}</view></view></view></view>
