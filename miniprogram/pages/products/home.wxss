.product-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.product-summary__label {
  color: #64748B;
  font-size: 26rpx;
}

.product-summary__value {
  color: #0F172A;
  font-size: 44rpx;
  font-weight: 700;
}
