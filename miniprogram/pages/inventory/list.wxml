<view class="container">
  <view class="simple-header">
    <view class="simple-title">库存查询</view>
    <view class="simple-subtitle">按型号、材质、厚度和库位查找成品</view>
  </view>
  <view class="form-section">
    <view class="form-field"><view class="form-label">产品搜索</view><input class="input" placeholder="型号或库位" value="{{filters.q}}" data-field="q" bindinput="onFilter" /></view>
    <view class="form-field"><view class="form-label">材质</view><input class="input" placeholder="例如 45#" value="{{filters.material}}" data-field="material" bindinput="onFilter" /></view>
    <view class="form-field"><view class="form-label">厚度</view><input class="input" type="digit" placeholder="例如 3.0" value="{{filters.thickness}}" data-field="thickness" bindinput="onFilter" /></view>
    <button class="btn secondary" bindtap="load">查询</button>
  </view>
  <state-view wx:if="{{loading}}" state="loading" title="正在读取产品库存" />
  <state-view wx:elif="{{error}}" state="error" title="产品库存加载失败" description="{{error}}" bind:retry="load" />
  <view wx:else class="data-list">
    <view wx:if="{{!items.length}}" class="empty">暂无产品库存</view>
    <view wx:for="{{items}}" wx:key="product_code" class="data-item">
      <view class="row"><view class="name">{{item.product_code}}</view><view class="badge numeric">{{item.quantity}}</view></view>
      <view class="meta">{{item.material_text}}｜厚度 {{item.thickness_text}}｜库位 {{item.location_text}}</view>
    </view>
  </view>
</view>
