<view class="container">
  <view class="simple-header">
    <view class="simple-title">库存流水</view>
    <view class="simple-subtitle">产品入库、出库与撤销记录</view>
  </view>

  <state-view wx:if="{{loading}}" state="loading" title="正在读取库存流水" />
  <state-view wx:elif="{{error}}" state="error" title="库存流水加载失败" description="{{error}}" bind:retry="load" />
  <view wx:else class="ledger-list">
    <view wx:if="{{!items.length}}" class="empty">暂无库存流水</view>
    <view wx:for="{{items}}" wx:key="id" class="ledger-item">
      <view class="row">
        <view class="name">{{item.code_text}}</view>
        <view class="badge">{{item.transaction_type}}</view>
      </view>
      <view class="ledger-change numeric">数量 {{item.quantity}}｜{{item.before_quantity}} → {{item.after_quantity}}</view>
      <view class="meta">{{item.operator_name_text}}｜{{item.remark_text}}｜{{item.created_at}}</view>
      <button wx:if="{{item.can_reverse && reverseForm.id !== item.id}}" class="danger-action" data-id="{{item.id}}" bindtap="showReverseForm">撤销这条流水</button>
      <view wx:if="{{reverseForm.id === item.id}}" class="reverse-panel">
        <view class="form-field"><view class="form-label">操作人</view><view class="selected-value">{{operatorName || '当前账号'}}</view></view>
        <view class="form-field"><view class="form-label">撤销原因 *</view><input class="input" placeholder="说明撤销原因" value="{{reverseForm.remark}}" data-field="remark" bindinput="onReverseInput" /></view>
        <view class="row">
          <button class="btn secondary" size="mini" bindtap="hideReverseForm">取消</button>
          <button class="btn danger" size="mini" bindtap="reverse" loading="{{reversingId === item.id}}" disabled="{{reversingId !== null}}">核对并撤销</button>
        </view>
      </view>
      <view wx:if="{{item.reversed_transaction_id}}" class="meta">已撤销/冲销</view>
    </view>
  </view>

  <confirm-sheet
    open="{{confirmOpen}}"
    title="确认撤销产品流水"
    lines="{{confirmLines}}"
    danger="{{true}}"
    submitting="{{reversingId !== null}}"
    bindcancel="cancelConfirm"
    bindconfirm="confirmSubmit"
  />
</view>
