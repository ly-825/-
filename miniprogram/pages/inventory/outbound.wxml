<view class="container">
  <view class="simple-header">
    <view class="simple-title">产品出库</view>
    <view class="simple-subtitle">选择可用库存，再填写本次出库信息</view>
  </view>

  <state-view wx:if="{{loading}}" state="loading" title="正在读取产品库存" />
  <state-view wx:elif="{{error}}" state="error" title="产品库存加载失败" description="{{error}}" bind:retry="load" />
  <block wx:else>
    <view class="form-section">
      <view class="form-field"><view class="form-label">产品搜索</view><input class="input" placeholder="型号、名称、材质、厚度或库位" value="{{searchKeyword}}" confirm-type="search" bindinput="onKeyword" bindconfirm="onSearch" /></view>
      <button class="btn secondary" bindtap="onSearch">搜索</button>
      <view class="form-label">已选产品</view>
      <view class="selected-value">{{selectedLabel}}</view>
      <view wx:if="{{!searchKeyword}}" class="empty">输入条件后搜索产品</view>
      <view wx:elif="{{!filteredOptions.length}}" class="empty">没有匹配的可出库库存</view>
      <view wx:else class="data-list">
        <view wx:for="{{filteredOptions}}" wx:key="product_code" class="data-item" bindtap="selectProduct" data-index="{{index}}">
          <view class="row"><view class="name">{{item.product_code_text}}</view><view class="badge numeric">{{item.quantity}}</view></view>
          <view class="meta">{{item.product_name_text}}｜{{item.material_text}}｜厚度 {{item.thickness_text}}｜库位 {{item.location_text}}</view>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="form-field"><view class="form-label">出库数量</view><input class="input" type="number" placeholder="请输入数量" value="{{form.quantity}}" data-field="quantity" bindinput="onInput" /></view>
      <view class="form-field"><view class="form-label">指定库位</view><input class="input" placeholder="可选；不填按所有库位 FIFO" value="{{form.location}}" data-field="location" bindinput="onInput" /></view>
      <view class="form-field"><view class="form-label">操作人</view><view class="selected-value">{{operatorName || '当前账号'}}</view></view>
      <view class="form-field"><view class="form-label">备注</view><input class="input" placeholder="填写客户或用途" value="{{form.remark}}" data-field="remark" bindinput="onInput" /></view>
      <button class="primary-action" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">确认出库</button>
    </view>
  </block>

  <confirm-sheet
    open="{{confirmOpen}}"
    title="核对产品出库"
    lines="{{confirmLines}}"
    submitting="{{submitting}}"
    bindcancel="cancelConfirm"
    bindconfirm="confirmSubmit"
  />
</view>
