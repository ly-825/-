page {
  min-height: 100%;
  background: #F8FAFC;
  color: #0F172A;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.header,
.page-heading {
  margin-bottom: 32rpx;
  padding: 8rpx 0;
}

.title,
.page-title {
  color: #0F172A;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle,
.page-subtitle {
  margin-top: 10rpx;
  color: #475569;
  font-size: 27rpx;
  line-height: 1.6;
}

.eyebrow {
  margin-bottom: 12rpx;
  color: #64748B;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.card {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.stat-card {
  min-height: 160rpx;
}

.stat-label {
  color: #475569;
  font-size: 26rpx;
  font-weight: 500;
}

.stat-value {
  display: block;
  margin-top: 12rpx;
  color: #0F172A;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
}

.section-title {
  margin-bottom: 20rpx;
  color: #0F172A;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
}

.menu-item,
.module-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 18rpx;
  background: #FFFFFF;
  transition: background-color 180ms ease, opacity 180ms ease;
}

.menu-item:active,
.module-card:active {
  background: #F1F5F9;
}

.menu-title,
.module-name {
  color: #0F172A;
  font-size: 30rpx;
  font-weight: 600;
}

.menu-desc {
  margin-top: 6rpx;
  color: #64748B;
  font-size: 25rpx;
}

.arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  color: #334155;
  font-size: 38rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 500;
}

.input,
.picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid #CBD5E1;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #0F172A;
  font-size: 30rpx;
}

.picker {
  display: flex;
  align-items: center;
}

.input:focus,
.picker:active {
  border-color: #334155;
  box-shadow: 0 0 0 4rpx rgba(51, 65, 85, 0.12);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0 0 16rpx;
  padding: 0 28rpx;
  border: 0;
  border-radius: 18rpx;
  background: #059669;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  transition: background-color 180ms ease, opacity 180ms ease;
}

.btn::after {
  border: 0;
}

.btn:active {
  background: #047857;
}

.btn.secondary {
  border: 1rpx solid #CBD5E1;
  background: #FFFFFF;
  color: #334155;
}

.btn.danger {
  background: #DC2626;
  color: #FFFFFF;
}

.btn[disabled],
.is-disabled {
  opacity: 0.45;
  pointer-events: none;
}

.list-item {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.list-item:last-child {
  margin-bottom: 0;
}

.reverse-panel {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #FECACA;
  border-radius: 18rpx;
  background: #FEF2F2;
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.name {
  min-width: 0;
  color: #0F172A;
  font-size: 30rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.meta {
  margin-top: 8rpx;
  color: #64748B;
  font-size: 25rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.badge {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F1F5F9;
  color: #334155;
  font-size: 24rpx;
  font-weight: 500;
}

.empty {
  padding: 56rpx 28rpx;
  color: #64748B;
  text-align: center;
}

.module-kicker,
.warning-text {
  color: #B45309;
  font-size: 25rpx;
  font-weight: 500;
}

.module-list {
  display: grid;
  gap: 20rpx;
}

.module-card {
  min-height: 120rpx;
  margin-bottom: 0;
}

.phase-card {
  min-height: 180rpx;
}

.error-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #FECACA;
  border-radius: 18rpx;
  background: #FEF2F2;
}

.error-title {
  color: #991B1B;
  font-weight: 600;
}

.error-description {
  margin-top: 8rpx;
  color: #B91C1C;
  font-size: 25rpx;
}

.simple-header {
  margin-bottom: 32rpx;
}

.simple-title {
  color: #0F172A;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.simple-subtitle {
  margin-top: 8rpx;
  color: #64748B;
  font-size: 26rpx;
}

.group-list {
  overflow: hidden;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.group-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #E2E8F0;
}

.group-row:last-child {
  border-bottom: 0;
}

.group-row:active {
  background: #F8FAFC;
}

.group-row__icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  flex: 0 0 56rpx;
}

.group-row__body {
  min-width: 0;
  flex: 1;
}

.group-row__title {
  color: #0F172A;
  font-size: 30rpx;
  font-weight: 600;
}

.group-row__meta {
  margin-top: 4rpx;
  color: #64748B;
  font-size: 26rpx;
  overflow-wrap: anywhere;
}

.group-row__status {
  color: #B45309;
}

.group-row__chevron {
  width: 40rpx;
  height: 40rpx;
  margin-left: 16rpx;
  flex: 0 0 40rpx;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 24rpx 0 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 18rpx;
  background: #059669;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-action::after {
  border: 0;
}

.primary-action:active {
  background: #047857;
}

.primary-action[disabled] {
  opacity: 0.45;
}

.form-section {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.form-field {
  margin-bottom: 24rpx;
}

.form-field:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 500;
}

.data-list,
.ledger-list {
  overflow: hidden;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.data-item,
.ledger-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #E2E8F0;
}

.data-item:last-child,
.ledger-item:last-child {
  border-bottom: 0;
}

.danger-action {
  min-height: 88rpx;
  margin: 20rpx 0 0;
  border: 1rpx solid #FECACA;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #DC2626;
  font-size: 28rpx;
}

.danger-action::after {
  border: 0;
}

.safe-action {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.numeric {
  font-variant-numeric: tabular-nums;
}

@media (prefers-reduced-motion: reduce) {
  .menu-item,
  .module-card,
  .btn {
    transition: none;
  }
}
