.connection {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  background: #FFFFFF;
  color: #0F172A;
}

.connection__main,
.connection__actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.connection__copy {
  min-width: 0;
}

.connection__dot {
  width: 16rpx;
  height: 16rpx;
  flex: 0 0 16rpx;
  border-radius: 999rpx;
  background: #64748B;
}

.connection--connected .connection__dot {
  background: #059669;
}

.connection--error .connection__dot {
  background: #DC2626;
}

.connection__title {
  font-size: 26rpx;
  font-weight: 600;
}

.connection__address {
  max-width: 360rpx;
  margin-top: 2rpx;
  overflow: hidden;
  color: #64748B;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-action {
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #CBD5E1;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #334155;
  font-size: 24rpx;
}

.mini-action::after {
  border: 0;
}
