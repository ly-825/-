.connection-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 56rpx;
  color: #64748B;
  font-size: 26rpx;
}

.connection-line__dot {
  width: 16rpx;
  height: 16rpx;
  flex: 0 0 16rpx;
  border-radius: 999rpx;
  background: #64748B;
}

.connection-line--connected .connection-line__dot {
  background: #059669;
}

.connection-error {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #FECACA;
  border-radius: 20rpx;
  background: #FEF2F2;
}

.connection-error__title {
  color: #991B1B;
  font-size: 26rpx;
  font-weight: 600;
}

.connection-error__address {
  margin-top: 6rpx;
  color: #B91C1C;
  font-size: 22rpx;
  overflow-wrap: anywhere;
}

.connection-error__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 16rpx;
}

.mini-action {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #CBD5E1;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #334155;
  font-size: 24rpx;
}

.mini-action::after {
  border: 0;
}
